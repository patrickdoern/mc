#!/bin/zsh
app="/Applications/Moonlight Commander.app"
if [[ ! -d "$app" ]]; then
    echo "mc: Moonlight Commander ist nicht installiert ($app)" >&2
    exit 1
fi
query=""
for argument in "${@:-.}"; do
    if [[ ! -e "$argument" ]]; then
        echo "mc: $argument existiert nicht" >&2
        exit 1
    fi
    encoded="$(/usr/bin/python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${argument:A}")"
    query+="${query:+&}path=$encoded"
done
exec open "moonlight-commander://open?$query"
