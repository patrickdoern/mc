#!/bin/zsh
app="/Applications/Moonlight Commander.app"
language() {
    local line code
    for line in "${(@f)$(defaults read -g AppleLanguages 2>/dev/null)}"; do
        line="${line//[][(),\" ]/}"
        code="${(L)line%%[-_]*}"
        [[ "$code" == (de|en) ]] && { echo "$code"; return; }
    done
    echo en
}
fail() {
    if [[ "$(language)" == de ]]; then echo "$1" >&2; else echo "$2" >&2; fi
    exit 1
}
encode() {
    local LC_ALL=C text=$1 result= character
    local -i index
    for (( index = 1; index <= ${#text}; index++ )); do
        character=$text[index]
        if [[ $character == [A-Za-z0-9._~-] ]]; then result+=$character; else result+=$(printf '%%%02X' "'$character"); fi
    done
    print -r -- $result
}
if [[ ! -d "$app" ]]; then
    fail "mc: Moonlight Commander ist nicht installiert ($app)" "mc: Moonlight Commander is not installed ($app)"
fi
query=""
for argument in "${@:-.}"; do
    if [[ ! -e "$argument" ]]; then
        fail "mc: $argument existiert nicht" "mc: $argument does not exist"
    fi
    encoded="$(encode "${argument:A}")"
    query+="${query:+&}path=$encoded"
done
exec open "moonlight-commander://open?$query"
